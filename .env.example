# JWT signing secret. Use a random value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret

# MySQL connection. Production deployments must replace every placeholder.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=math_ai_review
DB_USER=root
DB_PASSWORD=replace-with-your-database-password

# DISABLED | REQUIRED | PREFERRED | VERIFY_CA | VERIFY_IDENTITY
# REQUIRED only encrypts the connection. Set VERIFY_CA (with DB_SSL_CA) or
# VERIFY_IDENTITY to also authenticate the server certificate.
DB_SSL_MODE=DISABLED
DB_SSL_CA=

# Maximum number of reusable MySQL connections per backend instance.
DB_POOL_SIZE=8
DB_POOL_ACQUIRE_TIMEOUT_MS=3000

# A pooled connection idle for longer than this many seconds is re-validated
# with a ping before it is reused; 0 restores ping-on-every-acquire.
DB_POOL_IDLE_PING_SECONDS=60

# Seconds the per-request role/status/auth_version check is cached in process.
# 0 disables the cache and hits the database on every authenticated request.
AUTH_CACHE_TTL_SECONDS=10

# Set to 1 only when the backend sits behind exactly one trusted reverse proxy
# (Render, nginx, ...). X-Forwarded-For is then used to identify clients for
# rate limiting; leave it off when the backend is directly reachable.
TRUST_PROXY_HEADERS=0

# Paper storage directory. Mount persistent storage here in production.
UPLOAD_DIR=./uploads/papers

# OpenAI-compatible chat completions endpoint.
AI_API_BASE_URL=https://api.deepseek.com/chat/completions

# Do not commit your real API key.
AI_API_KEY=replace-with-your-api-key

# Example models: deepseek-v4-flash, deepseek-v4-pro, deepseek-chat.
AI_MODEL=deepseek-v4-flash

# Bound AI provider concurrency and pending work per backend instance.
AI_MAX_CONCURRENCY=4
AI_QUEUE_SIZE=32

# Windows/MSYS2 local CA bundle. Override this when deploying elsewhere.
AI_CA_BUNDLE=D:/msys64/ucrt64/etc/ssl/cert.pem
